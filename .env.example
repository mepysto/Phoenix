# ===========================================
# Phoenix Environment Variables
# ===========================================
# Development settings. scripts/setup.sh copies this to .env and fills in
# secrets; edit .env afterwards. Production: see .env.production.example.

# Node Environment
NODE_ENV=development

# ===========================================
# Database (PostgreSQL + PostGIS + TimescaleDB)
# ===========================================
DATABASE_URL=postgresql://phoenix:phoenix@localhost:25432/phoenix_db
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=phoenix
POSTGRES_DB=phoenix_db

# ===========================================
# Redis
# ===========================================
REDIS_PASSWORD=
REDIS_URL=redis://:phoenix-dev-redis@localhost:26379

# ===========================================
# API Server
# ===========================================
API_HOST=0.0.0.0
API_PORT=28000
API_DEBUG=true

# API Keys for internal endpoints
API_SYNC_KEY=your-secure-sync-api-key-here

# ===========================================
# Frontend (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:28000

# ===========================================
# 3D Map Tokens (Optional - for premium features)
# ===========================================
# Cesium Ion Token (for Cesium World Terrain)
# Get one at: https://cesium.com/ion/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Mapbox Token (for satellite imagery)
# Get one at: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ===========================================
# External Data Sources (Optional)
# ===========================================
# Most GDACS/Copernicus APIs are free and don't require keys
# Add keys here if needed for premium tiers

# GDACS API (usually no key needed)
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api

# Copernicus EMS
COPERNICUS_API_URL=https://emergency.copernicus.eu

# HDX API
HDX_API_URL=https://data.humdata.org/api/3

# ===========================================
# Security
# ===========================================
# JWT Secret for future authentication
JWT_SECRET=your-jwt-secret-here-change-in-production

# CORS origins (comma-separated or a JSON list)
CORS_ORIGINS=http://localhost:23000,http://127.0.0.1:23000

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO

# Accounts for needs/offers (Phase 2). Sign-in is by emailed one-time link.
PUBLIC_WEB_URL=http://localhost:23000
# Platform operators who approve organisations (comma-separated)
PLATFORM_ADMIN_EMAILS=
# Outgoing mail. Without SMTP_HOST, mail is only written to the API log.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Phoenix <no-reply@example.org>
# Development only: return the sign-in link in the API response
AUTH_DEV_RETURN_LINK=false

# Closed-tab area alerts (Web Push). Off unless set.
# Generate keys: cd apps/api && python -m scripts.gen_vapid_keys
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.org
