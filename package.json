{
  "name": "phoenix",
  "version": "0.1.0",
  "private": true,
  "description": "Digital twin platform where everyone can heal the wounds of the earth together",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/phoenix"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "start": "./scripts/start.sh",
    "start:dev": "./scripts/start.sh dev",
    "start:docker": "./scripts/start.sh docker",
    "start:db": "./scripts/start.sh db-only",
    "stop": "./scripts/stop.sh",
    "stop:clean": "./scripts/stop.sh clean",
    "status": "./scripts/status.sh",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "cd apps/api && if [ -x .venv/bin/python ]; then .venv/bin/python -m scripts.migrate; else python3 -m scripts.migrate; fi",
    "db:seed": "cd apps/api && if [ -x .venv/bin/python ]; then .venv/bin/python -m scripts.seed_data; else python3 -m scripts.seed_data; fi",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml $(test -f .env && echo --env-file .env) up -d",
    "doctor": "cd apps/api && if [ -x .venv/bin/python ]; then .venv/bin/python -m scripts.doctor; else python3 -m scripts.doctor; fi",
    "docker:dev": "docker compose -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.dev.yml $(test -f .env && echo --env-file .env) up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml $(test -f .env && echo --env-file .env) down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml $(test -f .env && echo --env-file .env) logs -f",
    "generate:types": "cd apps/web && pnpm generate:types",
    "generate:types:local": "cd apps/web && pnpm generate:types:local",
    "setup": "./scripts/setup.sh",
    "setup:prod": "./scripts/setup.sh --prod",
    "db:backup": "./scripts/backup-db.sh",
    "docker:prod": "docker compose -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.prod.yml --env-file .env up -d --build"
  },
  "devDependencies": {
    "@phoenix/eslint-config": "workspace:*",
    "@phoenix/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "protocol-buffers-schema@<3.6.1": "^3.6.1",
      "sharp@<0.35.5": "^0.35.5",
      "dompurify@<3.4.17": "^3.4.17",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
