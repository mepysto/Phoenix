# ===========================================
# Phoenix — production settings
# ===========================================
# scripts/setup.sh --prod <domain> <email> writes .env from this file and
# fills the secrets. Keep .env private (chmod 600); never commit it.

# Public address. Point its DNS A/AAAA record at this server before starting.
DOMAIN=phoenix.example.org
# Let's Encrypt account e-mail (certificate expiry notices)
ACME_EMAIL=ops@example.org

# --- Secrets (generated by setup.sh) ---
POSTGRES_USER=phoenix
POSTGRES_DB=phoenix_db
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_SYNC_KEY=

# --- Accounts (needs, offers, plans, challenges) ---
# Platform operators who approve and verify organisations, comma-separated
PLATFORM_ADMIN_EMAILS=
# Outgoing mail for sign-in links and notifications. Required in production:
# without it nobody can sign in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Phoenix <no-reply@example.org>

# --- Closed-tab area alerts (Web Push; generated by setup.sh) ---
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.org

# --- Responsible use (docs/RESPONSIBLE_USE.md §3) ---
# Generalise military aircraft/ship positions near armed-conflict events
CONFLICT_ZONE_POLICY=grid

# --- Optional upgrades: features stay off without their key ---
ANTHROPIC_API_KEY=
AISSTREAM_API_KEY=
# "1" switches off sources licensed for non-commercial use only
NEXT_PUBLIC_COMMERCIAL_DEPLOYMENT=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
